# Versioned parameters for the scheduled Eunomia community patrol.
#
# Routing: the shared runner (../shared/agent-runner.sh, contract in its
# README.md) executes one primary agent route and, only on a failed attempt,
# one fallback route. All task differences live in prompt.md; this file
# carries only the agent and scheduling parameters the entrypoint passes
# through to the runner. There are no fixed partitions, model roles, probes,
# or per-attempt budgets here or in the runner: the invoked Agent decides
# investigation, model collaboration, and validation, and OpenCode provider
# configuration comes from the Workspace's existing mounted/generated config.
# LITELLM_API_KEY is supplied by the existing Workspace Secret binding and is
# never stored or printed here.
export EUNOMIA_PATROL_TIMEZONE=America/Vancouver
export EUNOMIA_PATROL_AGENT_MODEL=gpt-5.6-sol
export EUNOMIA_PATROL_AGENT_EFFORT=high
export EUNOMIA_PATROL_FALLBACK_MODEL=qwen3.8-27b-nvfp4-200k
export EUNOMIA_PATROL_LOCAL_MODELS="qwen3.8-flash-next-nvfp4-220k glm-5.3-flash-nvfp4-dflash2-200k qwen3.8-27b-nvfp4-200k"
