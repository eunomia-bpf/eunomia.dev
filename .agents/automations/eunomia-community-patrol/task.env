# Versioned defaults for the scheduled Eunomia community patrol.
#
# Agent routing decision (2026-09-03): every configured model is an execution
# worker with full tool permissions inside the patrol's existing authorization
# boundary. Three local OpenCode workers process disjoint item partitions in
# parallel from isolated checkout pools. Codex then reconciles their completed
# actions, handles remaining items, and updates the shared patrol memory. This
# ordering prevents duplicate writes; it does not make Codex the sole writer or
# reduce another model to a read-only/advisory role. Model output remains
# untrusted evidence, but that is a verification rule rather than a permission
# restriction. OpenCode never falls back to another model. LITELLM_API_KEY is
# supplied by the existing Workspace Secret binding.
EUNOMIA_PATROL_COORDINATOR_AGENT=codex
EUNOMIA_PATROL_COORDINATOR_MODEL=gpt-5.6-sol
EUNOMIA_PATROL_COORDINATOR_REASONING_EFFORT=high
EUNOMIA_PATROL_WORKER_MODELS="qwen3.8-flash-next-nvfp4-220k glm-5.3-flash-nvfp4-dflash2-200k qwen3.8-27b-nvfp4-200k"
EUNOMIA_PATROL_WORKER_PROVIDER=spark_gateway
EUNOMIA_PATROL_WORKER_BASE_URL=https://models.yunwei37.com/v1
EUNOMIA_PATROL_TIMEZONE=America/Vancouver
