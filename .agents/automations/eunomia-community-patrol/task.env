# Versioned defaults for the scheduled Eunomia community patrol.
#
# Model routing decision (2026-09-02): the previous route always used Codex with
# gpt-5.6-sol. Prefer the two locally deployed Qwen models through the existing
# LiteLLM gateway, in the order below, because routine patrol work should use
# local capacity first. Risk: the gateway or a local model can be unavailable;
# the runner probes each route before the one patrol execution and then falls
# back to the original Codex model. Rollback: clear EUNOMIA_PATROL_LOCAL_MODELS
# to restore the previous route. LITELLM_API_KEY is supplied by the existing
# Workspace Secret binding; no provider secret is stored here.
EUNOMIA_PATROL_AGENT=codex
EUNOMIA_PATROL_LOCAL_MODELS="qwen3.8-flash-next-nvfp4-220k qwen3.8-27b-nvfp4-200k"
EUNOMIA_PATROL_LOCAL_PROVIDER=spark_gateway
EUNOMIA_PATROL_LOCAL_BASE_URL=https://models.yunwei37.com/v1
EUNOMIA_PATROL_MODEL=gpt-5.6-sol
EUNOMIA_PATROL_REASONING_EFFORT=high
EUNOMIA_PATROL_TIMEZONE=America/Vancouver
