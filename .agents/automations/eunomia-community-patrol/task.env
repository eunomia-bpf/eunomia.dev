# Versioned defaults for the scheduled Eunomia community patrol.
#
# Agent routing decision (2026-09-02): Codex with gpt-5.6-sol remains the only
# main Agent and the only process allowed to decide, modify repositories,
# commit, push, or send external messages. Three locally deployed models run in
# OpenCode as parallel read-only advisors for non-overlapping lanes. Their
# stdout is captured in separate temporary reports for Codex; an unavailable
# or timed-out advisor never blocks Codex, and OpenCode never falls back to a
# cloud or free model. Risk: local advice can be incomplete or wrong; Codex
# treats it as untrusted input. Rollback: clear EUNOMIA_PATROL_ADVISORY_MODELS
# and remove the advisory launch block, leaving the original Codex path intact.
# LITELLM_API_KEY is supplied by the existing Workspace Secret binding.
EUNOMIA_PATROL_AGENT=codex
EUNOMIA_PATROL_MODEL=gpt-5.6-sol
EUNOMIA_PATROL_REASONING_EFFORT=high
EUNOMIA_PATROL_ADVISORY_MODELS="qwen3.8-flash-next-nvfp4-220k glm-5.3-flash-nvfp4-dflash2-200k qwen3.8-27b-nvfp4-200k"
EUNOMIA_PATROL_ADVISORY_PROVIDER=spark_gateway
EUNOMIA_PATROL_ADVISORY_BASE_URL=https://models.yunwei37.com/v1
EUNOMIA_PATROL_ADVISORY_TIMEOUT_SECONDS=300
EUNOMIA_PATROL_TIMEZONE=America/Vancouver
